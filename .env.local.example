# Environment Variables Template
# Copy this file to .env.local and fill in your values

# ============================================
# SUPABASE CONFIGURATION (REQUIRED)
# ============================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Secret used by /api/cron/supabase-keepalive for cron-jobs.org requests
CRON_SECRET=replace-with-a-long-random-secret

# ⚠️ NOTE: Google OAuth credentials are configured in Supabase Dashboard
# NOT in this .env file. Go to:
# https://supabase.com/dashboard/project/_/auth/providers
# Enable Google provider and add your Google OAuth credentials there.

# ============================================
# APP CONFIGURATION
# ============================================

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FlavorQuest

# ============================================
# ADMIN CONFIGURATION
# ============================================
# Comma-separated list of admin email addresses
# Users with these emails will have admin access after signing in with Google

ADMIN_EMAILS=admin@example.com,another-admin@example.com

# ============================================
# FEATURE FLAGS (OPTIONAL)
# ============================================

NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true
NEXT_PUBLIC_ENABLE_TTS_FALLBACK=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

AZURE_API_KEY=your-azure-api-key

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://v98store.com/v1
OPENAI_MODEL=gemini-2.5-flash-lite-nothinking

# ============================================
# EMAIL / SMTP (Gmail)
# ============================================

MAIL_FROM_ADDRESS=noreply@flavorquest.com
MAIL_FROM_NAME="FlavorQuest"
MAIL_ENCRYPTION=tls
MAIL_HOST=smtp.gmail.com
MAIL_MAILER=smtp
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD="your-app-password"
